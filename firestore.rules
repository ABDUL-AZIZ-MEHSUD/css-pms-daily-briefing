
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == "LUUDVDjFWAdNv7fptJ58ITVFmui2";
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasActiveSubscription() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.subscriptionStatus == "active"
        && get(userPath(request.auth.uid)).data.subscriptionExpiry is timestamp
        && get(userPath(request.auth.uid)).data.subscriptionExpiry > request.time;
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          "displayName",
          "email",
          "createdAt"
        ])
        && request.resource.data.displayName is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;

      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["displayName"])
          && request.resource.data.displayName is string
        );

      allow delete: if isAdmin();

      match /progress/{articleId} {
        allow read, write: if isAdmin()
          || (signedIn() && request.auth.uid == uid && hasActiveSubscription());
      }

      match /customArticles/{articleId} {
        allow read, write: if isAdmin()
          || (signedIn() && request.auth.uid == uid && hasActiveSubscription());
      }
    }

    match /paymentRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "userId",
          "amount",
          "method",
          "transactionReference",
          "status",
          "createdAt"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.amount == 500
        && request.resource.data.method in ["easypaisa_jazzcash"]
        && request.resource.data.transactionReference is string
        && request.resource.data.transactionReference.size() >= 4
        && request.resource.data.transactionReference.size() <= 100
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time;

      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow update, delete: if isAdmin();
    }

    match /articles/{articleId} {
      allow read: if isAdmin() || hasActiveSubscription();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
